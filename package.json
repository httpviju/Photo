{
  "name": "vijay-portfolio",
  "productName": "Vijay Portfolio",
  "description": "Vijay Portfolio — Standalone Windows Desktop Application & Engineering Showcase",
  "author": "Vijay <thakorvijay51098@gmail.com>",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-icon.mjs && vite build && node scripts/sync-releases.mjs",
    "preview": "vite preview",
    "electron:dev": "node scripts/generate-icon.mjs && concurrently -k \"vite --port=3000\" \"wait-on tcp:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "dist": "chmod +x scripts/bin/wine scripts/wine-uninstaller-shim.cjs && rm -rf dist/*.exe dist/*.7z dist/*.yml dist/*.blockmap dist/win-unpacked && node scripts/generate-icon.mjs && vite build && PATH=\"$PWD/scripts/bin:$PATH\" electron-builder --win --x64 && node scripts/sync-releases.mjs",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.vijay.portfolio",
    "productName": "Vijay Portfolio",
    "copyright": "Copyright © 2025 Vijay",
    "asar": true,
    "compression": "store",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist/icon.svg",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "!node_modules/**/*",
      "!dist/*.exe",
      "!dist/*.nsis.7z",
      "!dist/*.yml",
      "!dist/*.blockmap",
      "!dist/releases/**/*",
      "!dist/win-unpacked/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vijay Portfolio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Vijay-Portfolio-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Vijay-Portfolio-Portable.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jszip": "^3.4.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.5.1"
  }
}
